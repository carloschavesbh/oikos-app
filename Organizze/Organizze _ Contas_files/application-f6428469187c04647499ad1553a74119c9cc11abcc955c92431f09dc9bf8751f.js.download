            </div>\n                                <div class="zze-category-selector__search-row">\n                                    <div class="zze-category-selector__search" role="search">\n                                        <span class="zze-category-selector__search-icon" aria-hidden="true">\n                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">\n                                                <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>\n                                                <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>\n                                            </svg>\n                                        </span>\n                                        <input type="search"\n                                            class="zze-category-selector__search-input"\n                                            ng-model="categorySelector.searchQuery"\n                                            ng-click="$event.stopPropagation()"\n                                            ng-keydown="categorySelector.onSearchKeydown($event)"\n                                            placeholder="Pesquisar"\n                                            autocomplete="off" />\n                                    </div>\n                                    <div class="zze-category-selector__ai-spark-slot">\n                                        <div ng-if="categorySelector.aiCategorySuggestLoading"\n                                            class="zze-ai-category-suggest-loader zze-category-selector__ai-spark-loader"\n                                            aria-busy="true">\n                                            <div class="app