{categorySelector.emptyRingGradientId}}" x1="0" y1="0" x2="0" y2="1" gradientUnits="objectBoundingBox">\n                                                        <stop offset="0%" stop-color="#E9EAEB"/>\n                                                        <stop offset="100%" stop-color="#FEFDF9"/>\n                                                    </linearGradient>\n                                                </defs>\n                                                <circle cx="28" cy="28" r="26.75" fill="#FEFDF9" stroke-width="1.5" ng-attr-stroke="{{ \'url(#\' + categorySelector.emptyRingGradientId + \')\' }}"/>\n                                            </svg>\n                                        </div>\n                                        <div class="zze-category-selector__empty-icon-inner">\n                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">\n                                                <path d="M9.80492 17.2959C13.9418 17.2959 17.2954 13.9423 17.2954 9.80541C17.2954 5.66854 13.9418 2.31494 9.80492 2.31494C5.66805 2.31494 2.31445 5.66854 2.31445 9.80541C2.31445 13.9423 5.66805 17.2959 9.80492 17.2959Z" stroke="#8FE6AB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>\n                                                <path d="M15.0156 15.4043L17.9523 18.3334" stroke="#8FE6AB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>\n                                            </svg>\n                                        </div>\n                                    </div>\n                                    <p class="zze-category-selector__empty-title">Sem resultados</p>\n                                    <p class="zze-category-selector__empty-text">Nenhuma categoria encontrada<br />referente a sua busca</p>\n                                </div>\n                                <ul ng-if="!categorySelector.hasNoMatchingCategories()">\n                                    <li ng-repeat="item in categorySelector.navigableItems track by categorySelector.navItemId(item, $index)"\n                                        ng-class="{\n                                            \'add-new\': item.type === \'add-new\',\n                                            \'is-sub\': item.type === \'category\' && item.category.parent_uuid,\n                                            \'zze-category-selector__li--kb-focus\': categorySelector.keyboardIndex === $index\n                                        }">\n                                        <a ng-if="item.type === \'add-new\'" href="" data-popup="true" data-url="{{::categorySelector.addCategoryUrl}}">\n                                            <div class="zze-category-icon">\n                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">\n                                                    <path d="M12 5C12.4141 5 12.75 5.33582 12.75 5.75V11H18C18.4141 11 18.75 11.3358 18.75 11.75C18.75 11.9766 18.6494 12.1797 18.4907 12.3171C18.3594 12.431 18.1875 12.5 18 12.5H12.75V17.75C12.75 18.1642 12.4141 18.5 12 18.5C11.5859 18.5 11.25 18.1642 11.25 17.75V12.5H6C5.58594 12.5 5.25 12.1642 5.25 11.75C5.25 11.3358 5.58594 11 6 11H11.25V5.75C11.25 5.33582 11.5859 5 12 5Z" fill="#454843"></path>\n                                                </svg>\n                                            </div>\n                                            <name>Criar categoria</name>\n                                        </a>\n                                        <a ng-if="item.type === \'category\'" href="" ng-click="categorySelector.selectCategory(item.category)" ng-class="{selected: item.category.id === categorySelector.transaction.category.id}">\n                                            <zze-category-icon ng-model="item.category"></zze-category-icon>\n                                            <name>{{item.category.name}}</name>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                            <div class="zze-category-selector__propagate-step" ng-if="categorySelector.step === \'propagate\'">\n                                <div class="zze-category-selector__header">\n                                    <h2 class="zze-category-selector__heading">Altera\xe7\xe3o salva!</h2>\n                                    <button type="button"\n                                        class="zze-category-selector__close"\n                                        ng-click="categorySelector.hide(); $event.stopPropagation();"\n                                        aria-label="Fechar">\n                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">\n                                            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>\n                                        </svg>\n                                    </button>\n                                </div>\n                                <p class="zze-category-selector__propagate-text">Este lan\xe7amento \xe9 recorrente. Deseja aplicar a mesma altera\xe7\xe3o nos pr\xf3ximos?</p>\n                                <div class="zze-category-selector__propagate-actions">\n                                    <button type="button" class="zze-category-selector__propagate-btn zze-category-selector__propagate-btn--secondary"\n                                        ng-click="categorySelector.confirmPropagateOnlyThis(); $event.stopPropagation();">\n                                        N\xe3o, apenas este\n                                    </button>\n                                    <button type="button" class="zze-category-selector__propagate-btn zze-category-selector__propagate-btn--primary"\n                                        ng-click="categorySelector.confirmPropagateFuture(); $event.stopPropagation();">\n                                        Sim, atualizar pr\xf3ximos\n                                    </button>\n                                </div>\n                            </div>\n                            <div class="ai-category-confirm-sheet zze-category-selector__ai-category-confirm"\n                                ng-if="categorySelector.aiCategoryConfirmOpen"\n                                ng-class="{ active: categorySelector.aiCategoryConfirmSheetActive }">\n                                <div class="bottom-sheet-dimming" ng-click="categorySelector.dismissAiCategoryConfirm()"></div>\n                                <div class="bottom-sheet-panel" role="dialog" aria-modal="true" ng-attr-aria-labelledby="{{ categorySelector.aiCategoryConfirmHeadingId }}" ng-click="$event.stopPropagation()">\n                                    <a href="" class="bottom-sheet-close ai-category-confirm-close" aria-label="Fechar"\n                                        ng-click="categorySelector.dismissAiCategoryConfirm(); $event.preventDefault();">\n                                        <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>\n                                    </a>\n                                    <h4 ng-attr-id="{{ categorySelector.aiCategoryConfirmHeadingId }}" class="ai-category-confirm-heading">Sugest\xe3o da IA</h4>\n                                    <div class="ai-category-confirm-suggestion-row">\n                                        <div>\n                                            <div class="ai-category-confirm-icon-wrap" aria-hidden="true" ng-bind-html="categorySelector.aiCategoryConfirmIconHtml"></div>\n                                        